{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bee-framework.local/schemas/updater/checksums-v1.schema.json",
  "title": "Bee update package checksums v1",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^(files|migrations)/(?!/).+[^/]$"
  },
  "additionalProperties": {
    "type": "string",
    "pattern": "^[0-9a-f]{64}$"
  }
}
